# =====================================================================
# LabSync Environment Configuration Template (.env.example)
# =====================================================================
# Instructions:
# 1. Copy this file to .env for local development: cp .env.example .env
# 2. For Railway deployment, add these keys directly into Railway Variables.
# 3. NEVER commit real passwords, secrets, or API keys to version control.
# =====================================================================

# ---------------------------------------------------------------------
# Application Runtime Environment
# ---------------------------------------------------------------------
# Set to 'production' on Railway or 'development' on your local machine.
NODE_ENV=development

# Port the Express HTTP server listens on (Railway provides this dynamically)
PORT=3000

# Canonical Application URL (used for password reset, email verification & CORS)
# Example production: https://labsync-production.up.railway.app
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Session Security
# ---------------------------------------------------------------------
# Secret string used to sign session cookies with HMAC-SHA256.
# Mandatory in production. Use a strong random string (e.g. openssl rand -hex 32).
SESSION_SECRET=change-this-to-a-secure-random-32-byte-hex-string-in-production

# Cookie Secure flag override (defaults to true in production, false in dev)
COOKIE_SECURE=false

# ---------------------------------------------------------------------
# Database Configuration (MySQL)
# ---------------------------------------------------------------------
# Connection details for the MySQL database.
# On Railway, you can connect to the Railway MySQL plugin variables:
# (MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=labsync

# ---------------------------------------------------------------------
# Outgoing Email / SMTP Configuration (Nodemailer)
# ---------------------------------------------------------------------
# Optional in development; required for password recovery and welcome emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_smtp_app_password
EMAIL_FROM="LabSync BulSU" <your_email@gmail.com>

# ---------------------------------------------------------------------
# CORS Allowed Origins
# ---------------------------------------------------------------------
# Comma-separated list of additional allowed origins if running frontend separately.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
